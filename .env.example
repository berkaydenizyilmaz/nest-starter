NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/mydb?schema=public

# Havuzdaki azami bağlantı. DB'nin max_connections değerini instance sayısına böl.
DATABASE_POOL_MAX=10

# En az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Güvenilen proxy'ler: hop sayısı (0 = proxy yok) ya da virgülle ayrılmış
# IP/CIDR listesi (loopback, linklocal, uniquelocal da olur). Web BFF üzerinden,
# mobil doğrudan geliyorsa liste kullan, ör. 10.0.0.0/8
# `true` ASLA kullanma: istemci X-Forwarded-For ile sahte IP gönderebilir.
TRUST_PROXY=0

# Virgülle ayrılmış origin listesi
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=debug

# İstek limiti: her endpoint için THROTTLE_TTL saniyede THROTTLE_LIMIT istek
THROTTLE_ENABLED=true
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Bu kopya kuyruktaki işleri ve zamanlamaları çalıştırsın mı (API kopyalarında
# kapatıp işleri ayrı bir sürece verebilirsin)
QUEUE_WORKERS_ENABLED=true

# Oturum temizleme, denetim kaydı ve anonimleştirme süreleri
SESSION_CLEANUP_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=730
USER_ANONYMIZATION_AFTER_DAYS=14

# Maildeki linklerin gittiği web uygulamasının kök adresi
APP_URL=http://localhost:3001

# Mail: console (geliştirme; maili göndermez, loga yazar) ya da resend.
# production'da console kabul edilmez.
MAIL_DRIVER=console
MAIL_FROM=Uygulama <no-reply@example.com>
# MAIL_DRIVER=resend ise zorunlu
# RESEND_API_KEY=re_...

# Dosya depolama (S3 uyumlu; R2 için endpoint
# https://<account_id>.r2.cloudflarestorage.com). Token yalnızca bu iki
# bucket'a okuma ve yazma yetkili olmalı.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BUCKET=
# Yarım kalan yüklemeler de burada, incoming/ önekinde
STORAGE_PRIVATE_BUCKET=
# Public bucket'ın bağlı olduğu, uygulamadan ayrı alan adı
STORAGE_PUBLIC_URL=

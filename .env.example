NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/mydb?schema=public

# Havuzdaki azami baglanti. DB'nin max_connections'ini instance sayisina bol.
DATABASE_POOL_MAX=10

# En az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Guvenilen proxy hop sayisi. 0 = proxy yok. `true` ASLA kullanma:
# istemci X-Forwarded-For ile sahte IP gonderebilir.
TRUST_PROXY=0

# Virgülle ayrılmış origin listesi
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=debug

# Cron job'ları etkinleştir
CRON_ENABLED=true

# Oturum temizleme, denetim kaydı ve anonimleştirme süreleri
SESSION_CLEANUP_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=730
USER_ANONYMIZATION_AFTER_DAYS=14
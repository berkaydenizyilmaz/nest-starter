generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role   @default(USER)

  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?

  avatarFileId String?
  avatarFile   StoredFile? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: Restrict)

  deletedAt    DateTime?
  anonymizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  oneTimeTokens OneTimeToken[]
  ownedFiles    StoredFile[]   @relation("StoredFileOwner")

  @@index([anonymizedAt, deletedAt])
  @@index([avatarFileId])
}

model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  device    String?
  ip        String?
  userAgent String?

  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId, usedAt])
}

model OneTimeToken {
  id        String @id @default(uuid())
  purpose   String
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  issuedAt  DateTime  @default(now())

  @@unique([userId, purpose])
}

enum StoredFileStatus {
  PENDING
  READY
}

enum StoredFileVisibility {
  PUBLIC
  PRIVATE
}

model StoredFile {
  id         String               @id @default(uuid())
  purpose    String
  visibility StoredFileVisibility
  status     StoredFileStatus     @default(PENDING)

  ownerId String?
  owner   User?   @relation("StoredFileOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  key          String? @unique
  contentType  String
  size         Int
  width        Int?
  height       Int?
  variants     Json?
  originalName String?

  createdAt DateTime  @default(now())
  readyAt   DateTime?

  userAvatars User[] @relation("UserAvatar")

  @@index([status, createdAt])
  @@index([status, readyAt])
  @@index([ownerId])
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model AuditLog {
  id      String       @id @default(uuid())
  event   String
  outcome AuditOutcome @default(SUCCESS)

  actorId    String?
  subjectId  String?
  targetType String?
  targetId   String?

  metadata  Json?
  ip        String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([event, outcome, createdAt])
}
